{
  "mode": "blacklist",
  "modules": [
    "ctypes",
    "importlib",
    "multiprocessing",
    "os",
    "pathlib",
    "pty",
    "resource",
    "shutil",
    "signal",
    "socket",
    "subprocess",
    "sys",
    "webbrowser"
  ],
  "functions": [
    "__import__",
    "compile",
    "delattr",
    "eval",
    "exec",
    "getattr",
    "globals",
    "locals",
    "open",
    "setattr",
    "vars"
  ],
  "deny_dunder": true,
  "deny_reflection": true,
  "regex_rules": [
    "__\\w+__\\s*\\(",
    "os\\s*\\.\\s*system\\s*\\("
  ],
  "preset_name": "標準"
}